# ==========================================================
# fhss-sdr .gitattributes — 换行符与文件类型规则
# 原则：仓库内一律 LF；Windows 批处理保持 CRLF；二进制不转换
# ==========================================================

# ---- 全局默认：文本文件提交时归一化为 LF，检出也用 LF ----
* text=auto eol=lf

# ---- HDL 与约束（Gowin EDA / 综合工具链） ----
*.v        text eol=lf
*.vh       text eol=lf
*.sv       text eol=lf
*.cst      text eol=lf
*.sdc      text eol=lf
*.tcl      text eol=lf
*.gprj     text eol=lf

# ---- 仿真与脚本（shell 必须 LF，CRLF 会导致执行失败） ----
*.sh       text eol=lf
*.py       text eol=lf
*.do       text eol=lf

# ---- 文档与参考数据（golden 数据比对依赖逐字节一致） ----
*.md       text eol=lf
*.txt      text eol=lf
*.csv      text eol=lf
*.hex      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# ---- Windows 批处理保持 CRLF ----
*.bat      text eol=crlf
*.cmd      text eol=crlf

# ---- 二进制：不做换行转换、不做文本 diff ----
*.bit      binary
*.bin      binary
*.fs       binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.zip      binary
*.7z       binary
*.vcd      binary
*.wlf      binary
*.fst      binary
