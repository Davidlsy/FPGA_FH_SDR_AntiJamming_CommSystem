# ==========================================================
# FPGA_FH_SDR_AntiJamming_CommSystem 仓库 .gitattributes — 换行符与文件类型规则
# 目标工具链：AMD Vivado / Vitis
# 原则：仓库内一律 LF；Windows 批处理保持 CRLF；二进制不转换
# ==========================================================

# ---- 全局默认：文本文件提交时归一化为 LF，检出也用 LF ----
* text=auto eol=lf

# ---- HDL 与约束（AMD Vivado / 综合实现工具链） ----
*.v        text eol=lf
*.vh       text eol=lf
*.sv       text eol=lf
*.svh      text eol=lf
*.vhd      text eol=lf
*.vhdl     text eol=lf
*.xdc      text eol=lf
*.sdc      text eol=lf
*.tcl      text eol=lf
*.xci      text eol=lf
*.bd       text eol=lf
*.xpe      text eol=lf
*.hwh      text eol=lf
*.xml      text eol=lf

# ---- 过渡期：若仍有 Gowin 遗留工程文件，保持文本 LF，避免误转换 ----
*.gprj     text eol=lf
*.cst      text eol=lf

# ---- 仿真与脚本（shell 必须 LF，CRLF 会导致执行失败） ----
*.sh       text eol=lf
*.py       text eol=lf
*.do       text eol=lf

# ---- 文档与参考数据（golden 数据比对依赖逐字节一致） ----
*.md       text eol=lf
*.txt      text eol=lf
*.csv      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# ---- 存储器初始化源文件（blk_mem_gen / $readmemh 输入，按源文件管理） ----
# 决策：本仓库的存储器初始化输入固定用 .hex/.coe/.mif/.mem，一律视为源文件，
# 不按扩展名在 .gitignore 中忽略。（.bin 归产物类，见 .gitignore 比特流段。）
*.hex      text eol=lf
*.coe      text eol=lf
*.mif      text eol=lf
*.mem      text eol=lf

# ---- Windows 批处理保持 CRLF ----
*.bat      text eol=crlf
*.cmd      text eol=crlf

# ---- 二进制：不做换行转换、不做文本 diff ----
*.bit      binary
*.bin      binary
*.binprm   binary
*.mcs      binary
*.fs       binary
*.dcp      binary
*.ltx      binary
*.mmi      binary
*.hwdef    binary
*.xsa      binary
*.xsim     binary
*.wdb      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.pdf      binary
*.zip      binary
*.7z       binary
*.vcd      binary
*.wlf      binary
*.fst      binary
