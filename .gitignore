# ==========================================================
# FPGA_FH_SDR_AntiJamming_CommSystem 仓库 .gitignore
# 适配 AMD（Xilinx）Vivado / Vitis / Vitis HLS
# ==========================================================

# ============ Vivado 工程 ============
# 决策：*.xpr 不入库，工程由 build/create_smoke_project.tcl 重建
# （create_project -> synth -> impl -> bitstream）。该脚本每次运行都会
# file delete -force 整个 build/vivado_smoke/，提交 .xpr 只会带来
# 绝对路径/时间戳/工具版本噪声。
# 注：*.xpr.user 需单独列出——「*.xpr」匹配不到「xxx.xpr.user」。
*.xpr.user
*.xpr
# 综合缓存（可重建，体积大）
*.cache/
# 硬件管理器会话
*.hw/
# 仿真相关工程目录
*.sim/                
# 综合 / 实现运行目录（synth_1、impl_1 等）
*.runs/                
# IP 用户文件（可重建）
*.ip_user_files/       
# 生成源目录（可重建）
*.gen/                
# 独立 IP 工程
*.managed_ip_project/  
# Vivado 会话 journal
*.jou                  
*.log
*.str
*.pb
# 波形数据库
*.wdb                  
# 通用波形
*.vcd                  
webtalk*.html
webtalk*.xml
webtalk*.csv
usage_statistics*
# 交付/导出压缩包（勿与源码归档混淆）
# 代价：裸写扩展名 → docs/ 、data/ 下的交付包一并被吞。docs/ 已在文末「交付物例外」
# 段开反选通道；data/ 下的证据包按既有判据移入 docs/ ，或就地加一行反选。
*.zip                  
# .7z 同 *.zip 口径（.gitattributes 已声明为 binary）
*.7z
# Vivado 临时目录
.Xil/                  
build/vivado_smoke/

# 检查点与比特流：大二进制，不入库；归档见文末 releases 规则
# design checkpoint
*.dcp                  
*.bit
# 拍板：*.bin 按产物忽略——Vivado impl 的 BG-BIN 裸比特流（fhss_top.bin）、
# bootgen 的 boot.bin、硬件交接的 *.hwh.bin 都落在这一类。
# 本仓库存储器初始化固定用 .hex/.coe/.mif/.mem（见 .gitattributes 存储器初始化段），
# 故不接受 .bin 作初始化输入。若日后确需入库某个 .bin 源文件，
# 就地加一行「!/<路径>/*.bin」，勿在此处放开全局——那会同时放开 impl 产物。
# 反选的边界：.bin 若落在已被排除的目录（build/ 等）内，该行无效——目录一旦
# 被排除，其下文件无法用「!」救回，只能改锚点（同下方 *_hls/ 的约束）。
*.bin
*.mcs
*.ltx
*.pdi
# 决策：锚定 build/ —— *.cfg 是通用扩展名（各工具的配置文件都可能用），裸写会静默吞掉
# sw/ 、board/ 下的配置类源文件，git status 不提示。本仓库当前无 .cfg 产出，此行为防线。
# 代价与 syn/ 、impl/ 一致：build/ 之外的 .cfg 以未跟踪文件显形——可见、可补一行规则。
/build/**/*.cfg

# ============ Vitis / Vitis Unified ============
# Vitis 临时
.vitis/               
# Vitis IDE
.ade/                  
# Vitis 工作区元数据
/build/**/_ide/
# 经典 SDK 工作区
.sdk/
# 硬件导出（可由 Vivado 重新导出）
*.xsa                  
*.hdf
# 决策：裸写 export/ 、platforms/ 这类「只有末尾斜杠」的模式（末尾斜杠仅表示
# 只匹配目录，不产生锚定）时在任意层级生效，会吞掉 src/export/ 、docs/platforms/
# 这类源码目录，且 git status 不提示（静默）。
# 判定依据（易记错）：锚定与否只看模式中「末尾以外」有没有 /，与开头那个 / 无关——
# 有则相对本文件所在目录（上面 build/vivado_smoke/ 就是靠中间那个 / 锚定的），
# 没有则在任意层级匹配。故锚定到本仓库唯一构建根 build/
# （见 docs 实现方案：build/ 提供一键 Tcl 重建）。
# 代价：若日后把 Vitis 工作区建到 build/ 之外，产物会以「未见过的未跟踪大目录」
# 出现在 git status —— 可见、可补一行规则；优于静默吞源码。
/build/**/export/
/build/**/platforms/
# 平台描述（若由脚本生成）
*.xpfm                  

# 软件/应用构建产物
# 拍板：*.hex 不按扩展名全局忽略。本仓库 .hex 是存储器初始化源文件
# （cfg_rom / FIR 系数等 blk_mem_gen / $readmemh 输入，见 docs/amd-fhss-sim-only-plan.html）。
# Vitis/SDK 编译产出的 .hex 由下方「软件编译输出目录」规则挡住。
*.elf
*.map
*.o
*.obj
*.a
*.so
*.so.*
*.out
*.axf

# 软件编译输出目录（产物随目录走，不误伤源文件）
# 同 syn/ 、impl/ 、csim/ 、cosim/ 判据：Debug/ 、Release/ 是通用单词，裸写时
# 末尾斜杠只表示「只匹配目录」、不产生锚定（见上文 export/ 段），会在任意层级
# 生效，静默吞掉 src/ps/Debug/ 这类同名源码目录，故锚定唯一构建根 build/。
# 代价同 *_hls/ ：Vitis 工作区若建到 build/ 之外，其 Debug/Release 产物——含本
# 仓库唯一靠目录规则挡住、未做扩展名全局忽略的 .hex（见上文拍板）——会以未跟踪
# 文件显形：可见、可补一行规则；优于静默吞源码。
/build/**/Debug/
/build/**/Release/
RemoteSystemsTempFiles/

# Vitis HLS / Vivado HLS
# 决策：HLS 工程目录锚定 build/。裸 *_hls/ 与裸 syn/ 、impl/ 同类——通用
# 后缀 + 无锚点，凡是名字以 _hls 结尾的目录一并吞掉，src/dsp_hls/、
# src/fir_hls/ 这种「DSP 的 HLS 实现」命名正好撞上（本项目明确走 HLS 路线，
# 见 docs/fpga-fhss-amd-implementation-plan.html 的 UG1399 引用），且
# git status 不提示（静默）。
# 注意：目录一旦被排除，其下文件无法用「!」反选回来，故只能改锚点，
# 不能加例外规则。代价与 syn/ 、impl/ 一致：HLS 工程若建到 build/ 之外，
# 会以未跟踪目录出现在 git status —— 可见、可补一行规则；优于静默吞源码。
/build/**/*_hls/
*.autopilot/
# HLS 部分中间目录
*.zynq/                
# HLS 工程运行目录
*.prj/
*.aocx
*.xo
*.xclbin
# HLS 解（solution）内的运行目录，同样锚定 build/：
# 裸 syn/ 、impl/ 、csim/ 、cosim/ 会吞掉 src/syn/ 、src/impl/ 、sim/cosim/ 这类源码目录
/build/**/csim/
/build/**/cosim/
/build/**/syn/
/build/**/impl/
hls.app

# ============ 仿真产物（Icarus / ModelSim / Verilator / xsim） ============
# iverilog 编译产物
*.vvp                  
*.fst
# ModelSim / Questa 波形
*.wlf                  
vsim.lock
# ModelSim / Questa 优化波形：wlft 前缀且无扩展名，*.wlf 覆盖不到
# 代价：这是裸前缀通配，任何以 wlft 开头的文件都会被吞（实测 wlft_notes.md 也命中）。
# 与 ModelSim 的临时文件名一致故保留；若日后确需入库同类名文件，改为就近锚定。
wlft*
# ModelSim 会话日志
/sim/**/transcript
/transcript
# ModelSim 编译库
/sim/**/work/
#根目录
/work/             
xsim.dir/
# xsim / xvhdl / xvlog / xelab 的日志与 JVM 崩溃日志 hs_err_pid*.log 同样由 *.log
# 覆盖（见「Vivado 工程」段），不再逐条重复——避免读者误以为只有这几条 log 会被忽略。
# Verilator 输出
obj_dir/              

# ============ Python 上位机（sw/） ============
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
# 工具缓存与打包元数据（uv / pytest / ruff / mypy）
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
*.egg-link
# pytest-cov：.coverage 是基础数据；并发模式另写 .coverage.<host>.<pid>，htmlcov/ 是
# HTML 报告目录（量大、可重建）。coverage.xml 有意不挡——同 *.log 判据，它可能是
# 交付物，需入库时放 docs/ 。
.coverage
.coverage.*
htmlcov/
sw/**/build/
sw/dist/

# ============ MATLAB 浮点参考链 ============
# 自动保存文件
*.asv                  

# 代码生成 / Simulink 缓存（可重建；浮点参考链若走 codegen 会在此落盘）
slprj/

# ============ 临时 / 备份文件 ============
*.tmp
*.bak
*~
*.orig
*.rej

# ============ 操作系统 / 编辑器 ============
.DS_Store
Thumbs.db
desktop.ini
# vim 交换文件：*.swp 之外，同一文件被第二个实例打开时依次写 .swo / .swn
*.swp
*.swo
*.swn
# 决策：.idea/ 与 .vscode/ 都写成 .xxx/* 而非 .xxx/ —— 目录被整体排除时，其下文件
# 无法用「!」反选回来（实测：「.vscode/ + !.vscode/tasks.json」仍被忽略，改成
# .vscode/* 才生效）。两处写法保持一致，避免换一个 IDE 就出现「配置能共享」与
# 「整目录被吞」的不对称。
.idea/*
.vscode/*
# 反选共享的部分：IDEA 运行配置（跑 tcl / iverilog / xsim 的启动项）
!.idea/runConfigurations/
# 反选共享的部分：跑 tcl / iverilog / xsim 的任务与编辑器设置
!.vscode/tasks.json
!.vscode/settings.json

# ============ 大数据 ============
# 原始射频捕获不入库；doc/ 下测试数据 CSV 为交付物，正常提交
# 注：raw_capture/ 是本文件唯一「按意图而非按位置」的规则，刻意不加锚点——
# 捕获落点由采集脚本决定（data/ 、board/ 、临时目录都可能），锚住反而漏挡大文件。
# 依据：两词描述性命名，与源码目录重名的概率极低；上面的 syn/ 、impl/ 是通用单词，
# 风险量级不同，才需要锚定。
raw_capture/
*.cap

# ============ 交付物例外（必须置于所有忽略规则之后） ============
# docs/ 是评审证据树：docs/report/ 下的综合日志（synth.log）、链接 map
# （link.map）是交付物本身，不是构建噪声。
# 与上面 *_hls/ 的区别：*.log / *.map / *.zip / *.7z 是「扩展名规则与用途天生冲突」——
# 同一个扩展名既可能是构建产物，又可能是交付物，按位置锚不干净。
# 但这里是文件级排除，父目录 docs/ 未被排除，所以尾部反选可行
# （对比：*_hls/ 排除的是目录，子文件无法反选，只能改锚点）。
# 副作用：误落进 docs/ 的构建日志会以未跟踪文件出现 —— 可见，人工决定。
# 反向注意：反选通道只对 docs/ 开放。本该入库的证据日志若落在 docs/ 之外
# （如 data/ 、sim/ 下的 *.log），会被 *.log 静默吞掉——git status 不提示，
# git add . 也不报错，只在事后核对交付物时才发现缺席。故证据文件一律放 docs/。
# *.zip / *.7z 同理且更易踩：证据常被打包交付，落在 docs/ 之外同样静默消失——文末
# releases/ 那几条注释只管比特流归档，不管文档证据包。
# 当前仓库内 docs/ 下尚无此类文件，此四行是为「证据入库」预留的通道。
!docs/**/*.log
!docs/**/*.map
!docs/**/*.zip
!docs/**/*.7z

# 如需归档提交版比特流：把 bitstream 放入 releases/ 并取消下行注释
# !releases/*.bit
# !releases/*.mcs
# !releases/*.zip
# !releases/*.7z
# 注：*.zip / *.7z 已被上面全局忽略（防交付/导出包混入源码归档），
# 确需归档时再启用对应行。
